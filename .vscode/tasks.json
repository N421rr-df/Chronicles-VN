{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "NotebookLM - Projeto Completo",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/tools/exportar_notebooklm.py"
            ]
        },
        {
            "label": "NotebookLM - Código",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/tools/exportar_codigo_notebooklm.py"
            ]
        },
        {
            "label": "NotebookLM - Engenharia Reversa",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/tools/exportar_engenharia_reversa.py"
            ]
        },
        {
            "label": "NotebookLM - Dependências",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/tools/exportar_dependencias.py"
            ]
        },
        {
            "label": "NotebookLM - Parte 3",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/tools/exportar_parte3.py"
            ]
        },
        {
            "label": "NotebookLM - Atualizar Tudo",
            "dependsOn": [
                "NotebookLM - Projeto Completo",
                "NotebookLM - Código",
                "NotebookLM - Engenharia Reversa",
